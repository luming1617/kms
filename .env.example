POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=ics
POSTGRES_PASSWORD=ics
POSTGRES_DATABASE=ics
POSTGRES_MAX_CONNECTIONS=20
# 必须为空：非空会静默覆盖全部 workspace（启动自检强制）
POSTGRES_WORKSPACE=

ICS_ENABLE_RERANK=false
ICS_TOP_K=40
ICS_CHUNK_TOP_K=20
ICS_MAX_TOTAL_TOKENS=12000
ICS_ANSWER_MIN_CHUNKS=2
ICS_L2_BATCH_DISCARD_RATIO=0.5
ICS_LLM_MODEL_ID=local-llm
ICS_PROMPT_VERSION=v1
ICS_ENABLE_ANSWER_CACHE=false
ICS_RERANK_MODEL=default
ICS_MIN_RERANK_SCORE=0.5

# 会话：请求体只传 question；授权维度由网关签发 X-ICS-Session
ICS_SESSION_SECRET=replace-with-at-least-32-characters
ICS_SESSION_MAX_AGE_SECONDS=300

# 检索执行层（连接池启动参数，禁止用会话 GUC 传 scope）
POSTGRES_HNSW_EF_SEARCH=40
POSTGRES_HNSW_ITERATIVE_SCAN=off
POSTGRES_HNSW_MAX_SCAN_TUPLES=20000
POSTGRES_HNSW_SCAN_MEM_MULTIPLIER=1

# 服务入口
ICS_API_HOST=0.0.0.0
ICS_API_PORT=8000
ICS_EMBEDDING_BASE_URL=
ICS_EMBEDDING_API_KEY=
ICS_EMBEDDING_TIMEOUT_SECONDS=30
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PUSHGATEWAY_URL=
ICS_ADMIN_TOKEN=
ICS_NLU_BASE_URL=
ICS_NLU_MODEL=
ICS_NLU_API_KEY=
ICS_FRAMEWORK_RETRY_ATTEMPTS=2
ICS_PUBLISH_LOCK_TIMEOUT_SECONDS=30
